# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# systemd generates mount units based on this file, see systemd.mount(5).
# Please run 'systemctl daemon-reload' after making changes here.
#

# <file system> <mount point>   <type>  <options>       <dump>  <pass>

# / was on /dev/nvme2n1p2 during installation
UUID=440a4762-4a3d-4d57-b2c8-94cdeb5f6081 /               btrfs   noatime,compress=zstd,ssd,discard=async,subvol=@	 0       0
UUID=440a4762-4a3d-4d57-b2c8-94cdeb5f6081 /home           btrfs   noatime,compress=zstd,ssd,discard=async,subvol=@home	 0       0

# /boot/efi was on /dev/nvme0n1p1 during installation
#UUID=DAB7-6E41  /boot/efi       vfat    umask=0077      0       1

# /boot/efi is now on /dev/nvme2n1p1 changed by me during the installation
UUID=0DA0-A1F7	  /boot/efi       vfat    umask=0077      0       1

# Storage device - Auto-mounted
UUID=DEE2AF03E2AEDF51    /media/ahmdhosni/Storage    ntfs    defaults,uid=1000,gid=1000,dmask=000,fmask=000    0    0
